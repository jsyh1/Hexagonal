<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #f4f6f8;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.poli.infrastructure.ui.Controller">

    <!-- ===================================================== -->
    <!-- ENCABEZADO -->
    <!-- ===================================================== -->

    <top>
        <VBox spacing="5"
              style="-fx-background-color: linear-gradient(to right, #2c3e50, #34495e);">

            <padding>
                <Insets bottom="18"
                        left="25"
                        right="25"
                        top="22" />
            </padding>

            <Label style="-fx-font-size: 26px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"
                   text="Gestión de Drones" />

            <Label style="-fx-font-size: 13px;
                          -fx-text-fill: #bdc3c7;"
                   text="Administra el registro de drones del sistema" />

        </VBox>
    </top>

    <!-- ===================================================== -->
    <!-- CONTENIDO CENTRAL -->
    <!-- ===================================================== -->

    <center>
        <VBox spacing="18">

            <padding>
                <Insets bottom="25"
                        left="25"
                        right="25"
                        top="20" />
            </padding>

            <!-- ================================================= -->
            <!-- FORMULARIO -->
            <!-- ================================================= -->

            <VBox spacing="14"
                  style="-fx-background-color: white;
                         -fx-background-radius: 8;
                         -fx-border-radius: 8;
                         -fx-border-color: #e0e4e8;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">

                <padding>
                    <Insets bottom="18"
                            left="20"
                            right="20"
                            top="18" />
                </padding>

                <Label style="-fx-font-size: 16px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #2c3e50;"
                       text="Datos del Drone" />

                <!-- ================================================= -->
                <!-- DATOS DEL DRONE -->
                <!-- ================================================= -->

                <GridPane hgap="40.0"
                          vgap="12.0">

                    <!-- ID -->

                    <Label style="-fx-font-weight: 600;
                                  -fx-text-fill: #566573;"
                           text="ID:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0" />

                    <TextField fx:id="txtId"
                               promptText="ID del drone"
                               style="-fx-background-radius: 5;
                                      -fx-border-radius: 5;
                                      -fx-border-color: #d0d5da;
                                      -fx-padding: 6 10;"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0" />

                    <!-- SERIAL -->

                    <Label style="-fx-font-weight: 600;
                                  -fx-text-fill: #566573;"
                           text="Serial:"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="0" />

                    <TextField fx:id="txtSerial"
                               promptText="Serial"
                               style="-fx-background-radius: 5;
                                      -fx-border-radius: 5;
                                      -fx-border-color: #d0d5da;
                                      -fx-padding: 6 10;"
                               GridPane.columnIndex="3"
                               GridPane.rowIndex="0" />

                    <!-- MODELO -->

                    <Label style="-fx-font-weight: 600;
                                  -fx-text-fill: #566573;"
                           text="Modelo:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1" />

                    <TextField fx:id="txtModelo"
                               promptText="Modelo del drone"
                               style="-fx-background-radius: 5;
                                      -fx-border-radius: 5;
                                      -fx-border-color: #d0d5da;
                                      -fx-padding: 6 10;"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="1" />

                    <!-- PESO -->

                    <Label style="-fx-font-weight: 600;
                                  -fx-text-fill: #566573;"
                           text="Peso:"
                           GridPane.columnIndex="2"
                           GridPane.rowIndex="1" />

                    <TextField fx:id="txtPeso"
                               promptText="Peso del drone"
                               style="-fx-background-radius: 5;
                                      -fx-border-radius: 5;
                                      -fx-border-color: #d0d5da;
                                      -fx-padding: 6 10;"
                               GridPane.columnIndex="3"
                               GridPane.rowIndex="1" />

                    <!-- TIPO -->

                    <Label style="-fx-font-weight: 600;
                                  -fx-text-fill: #566573;"
                           text="Tipo de dron:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2" />

                    <ChoiceBox fx:id="cbTipo"
                               prefWidth="200"
                               style="-fx-background-radius: 5;
                                      -fx-border-radius: 5;
                                      -fx-border-color: #d0d5da;"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="2">

                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Vigilancia" />
                                <String fx:value="Agricultura" />
                            </FXCollections>
                        </items>

                        <value>
                            <String fx:value="Seleccionar" />
                        </value>

                    </ChoiceBox>

                </GridPane>

                <!-- ================================================= -->
                <!-- BOTONES -->
                <!-- ================================================= -->

                <HBox spacing="12">

                    <Button fx:id="btnNuevo"
                            onAction="#nuevoDron"
                            prefHeight="25.0"
                            prefWidth="72.0"
                            style="-fx-background-color: #3498db;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 5;
                                   -fx-cursor: hand;"
                            text="Nuevo" />

                    <Button fx:id="btnGuardar"
                            onAction="#guardarDron"
                            prefHeight="25.0"
                            prefWidth="73.0"
                            style="-fx-background-color: #27ae60;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 5;
                                   -fx-cursor: hand;"
                            text="Guardar" />

                    <Button fx:id="btnEditar"
                            onAction="#editarDron"
                            prefHeight="25.0"
                            prefWidth="58.0"
                            style="-fx-background-color: #f39c12;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 5;
                                   -fx-cursor: hand;"
                            text="Editar" />

                    <Button fx:id="btnEliminar"
                            onAction="#eliminarDron"
                            prefHeight="25.0"
                            prefWidth="69.0"
                            style="-fx-background-color: #e74c3c;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 5;
                                   -fx-cursor: hand;"
                            text="Eliminar" />

                </HBox>

            </VBox>

            <!-- ===================================================== -->
            <!-- TABLA -->
            <!-- ===================================================== -->

            <VBox spacing="10"
                  style="-fx-background-color: white;
                         -fx-background-radius: 8;
                         -fx-border-radius: 8;
                         -fx-border-color: #e0e4e8;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"
                  VBox.vgrow="ALWAYS">

                <padding>
                    <Insets bottom="18"
                            left="20"
                            right="20"
                            top="18" />
                </padding>

                <Label style="-fx-font-size: 16px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #2c3e50;"
                       text="Drones registrados" />

                <TableView fx:id="tblDrones"
                           style="-fx-background-radius: 5;
                                  -fx-border-radius: 5;
                                  -fx-border-color: #e0e4e8;"
                           VBox.vgrow="ALWAYS">

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>

                    <columns>

                        <TableColumn fx:id="colId"
                                     prefWidth="100"
                                     text="ID" />

                        <TableColumn fx:id="colSenal"
                                     prefWidth="150"
                                     text="Señal" />

                        <TableColumn fx:id="colModelo"
                                     prefWidth="200"
                                     text="Modelo" />

                        <TableColumn fx:id="colPeso"
                                     prefWidth="150"
                                     text="Peso" />

                    </columns>

                </TableView>

            </VBox>

        </VBox>
    </center>

</BorderPane>